spring.application.name: gateway

server:
  port: 8080

spring:
  cloud:
    gateway:
      routes:
        - id: user-management-service
          uri: http://localhost:8081
          predicates:
            - Path=/api/v1/auth/**
            - Path=/api/v1/users/**
            - Path=/api/v1/password/reset/**

        - id: innotter-service
          uri: http://localhost:8082
          predicates:
            - Path=/api/v1/pages/**
            - Path=/api/v1/posts/**
            - Path=/api/v1/tags/**
