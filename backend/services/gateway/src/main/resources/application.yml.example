spring.application.name: gateway

server:
  port: 8080

spring:
  data:
    redis:
      host: localhost
      port: 6379

  cloud:
    gateway:
      routes:
        - id: user-management-service
          uri: http://localhost:8081
          predicates:
            - Path=/api/v1/auth/**

        - id: user-management-service
          uri: http://localhost:8081
          predicates:
            - Path=/api/v1/users/**

        - id: user-management-service
          uri: http://localhost:8081
          predicates:
            - Path=/api/v1/password/reset/**

        - id: innotter-service
          uri: http://localhost:8082
          predicates:
            - Path=/api/v1/pages/**

        - id: innotter-service
          uri: http://localhost:8082
          predicates:
            - Path=/api/v1/posts/**

        - id: innotter-service
          uri: http://localhost:8082
          predicates:
            - Path=/api/v1/tags/**
      default-filters:
        - PreserveHostHeader